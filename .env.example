# For Gmail users:
# Make sure to enable IMAP in Gmail settings.
# After that: 1. Activate two-step verification on the corresponding account.
#             2. Create an app password.
#             3. Replace GMPASS with the generated app password (16-character password).

GMUSER = youremail@gmail.com
GMPASS = your_16_char_gmail_app_password

HOST = smtp.gmail.com
PORT = 587

# IMPORTANT: main.py expects MONGO_URI (not MONGO_URL)
MONGO_URI = mongodb+srv://<username>:<password>@abcdcluster.mongodb.net/?retryWrites=true&w=majority # get this from your MongoDB Atlas cluster
DB_NAME = your_mongodb_database_name
COLLECTION_NAME = your_mongodb_database_collection_name
